{
  "name": "vikingr",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run content && vite",
    "build": "npm run content && tsc --noEmit && vite build",
    "build:pwa": "npm run content && tsc --noEmit && VITE_PWA=1 vite build",
    "preview": "vite preview",
    "content": "tsx tools/build-content.ts",
    "map": "tsx tools/build-map.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate": "tsx tools/validate.ts",
    "lint:style": "tsx tools/narrative/lint-style.ts",
    "scan": "tsx tools/narrative/render-scan.ts",
    "continuity": "tsx tools/narrative/continuity.ts",
    "audit": "tsx tools/narrative/audit-choices.ts",
    "gauntlet": "tsx tools/gauntlet/gauntlet.ts",
    "bot": "tsx tools/bot.ts",
    "measure:duel": "tsx tools/measure-duel.ts",
    "measure:battle": "tsx tools/measure-battle.ts",
    "measure:830": "tsx tools/measure-830.ts",
    "measure:831": "tsx tools/measure-831.ts",
    "measure:sandbox": "tsx tools/measure-sandbox.ts",
    "measure:host": "tsx tools/measure-host.ts",
    "measure:trade": "tsx tools/measure-trade.ts",
    "measure:power": "tsx tools/measure-power.ts",
    "measure:hird": "tsx tools/measure-hird.ts",
    "measure:scout": "tsx tools/measure-scout.ts",
    "measure:world": "tsx tools/measure-world.ts",
    "measure:pace": "tsx tools/measure-pace.ts",
    "measure:makeup": "tsx tools/measure-makeup.ts",
    "measure:lineage": "tsx tools/measure-lineage.ts",
    "measure:era": "tsx tools/measure-era.ts",
    "smoke": "tsx tools/smoke.ts",
    "smoke:843": "tsx tools/smoke-843.ts",
    "smoke:865": "tsx tools/smoke-865.ts",
    "check": "npm run typecheck && npm test && npm run validate && npm run lint:style && npm run scan -- --runs=2 --strict && npm run continuity -- --runs=4 --strict && npm run gauntlet -- --fast && npm run bot -- --runs 100 --years 10",
    "build:artifact": "npm run content && tsc --noEmit && VITE_ARTIFACT=1 vite build && tsx tools/build-artifact.ts",
    "art": "tsx tools/art.ts"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.3",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/alegreya-sc": "^5.3.0",
    "@fontsource/noto-sans-runic": "^5.3.0",
    "preact": "^10.29.8",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
