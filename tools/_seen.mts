import { readFileSync } from 'node:fs';
import { dateOf } from '../src/engine/calendar';
const raw = JSON.parse(readFileSync(process.argv[2]!, 'utf8'));
const s = raw.state ?? raw;
const fmt = (d: number) => { const x = dateOf(d); return `${x.dom}/${x.month + 1}/${x.year}`; };
const seen = Object.entries(s.seen as Record<string, number>).sort((a, b) => a[1] - b[1]);
for (const [id, d] of seen) if (d >= 1380) console.log(fmt(d), d, id);
console.log('flags', Object.keys(s.flags).filter((k) => /outlaw|ubbi|court|wife|woo|asta|ingib|thorunn|marr/i.test(k)).join(' '));
console.log('wives', JSON.stringify(s.base?.wife ?? s.wife ?? s.base?.wives), 'captains ubbi', JSON.stringify(s.captains?.ubbi));
console.log('provisions', s.provisions, 'crew', JSON.stringify(s.crew), 'ships', JSON.stringify(s.ships));
